{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Furet",
  "version": "1.0.0",
  "identifier": "app.furet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "ile",
        "title": "Furet",
        "width": 900,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://furet-mini.localhost furet-mini: http://furet-fichier.localhost furet-fichier:; media-src http://furet-fichier.localhost furet-fichier:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Furet contributors",
    "category": "Utility",
    "shortDescription": "Retrouve un fichier par ce qu'il contient",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "licenseFile": "../../LICENSE",
    "copyright": "Furet — GPL-3.0"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRkJERDcxNzhGN0VFRUIKUldUcjd2ZDRjZDM3NGtOU0VORHd6N1gwZXUwOFNGMlM2VytYVFNDbVNxZkI5ZSsyeU8xakwwaUUK",
      "endpoints": [
        "https://github.com/blasteur1916/furet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
